# Copy to .env and adjust. Docker Compose reads .env automatically.
# Every variable is optional; unset or empty values use the defaults shown.

# Host port the server is published on.
NCGL_PORT=8080

# Public base URL clients use to reach the server, e.g. https://pods.example.com.
# Recommended behind a reverse proxy. If empty, it's derived from the
# Host / X-Forwarded-* request headers.
NCGL_PUBLIC_URL=

# Reverse proxies (IPs or CIDR ranges, comma-separated) whose X-Forwarded-For
# header gives the real client IP for login throttling, e.g. 172.16.0.0/12.
NCGL_TRUSTED_PROXIES=

# Set to true to allow fetching podcast feeds and images from loopback/private
# addresses (e.g. a feed hosted on your LAN).
NCGL_ALLOW_LOCAL_REMOTE_SERVERS=false

# Log filter, e.g. debug or nc_gpodder_lite=debug,tower_http=info.
RUST_LOG=nc_gpodder_lite=info,tower_http=info
